# ALC *local-only* integrations (object store, AAP). Copy to alc.local.env (gitignored).
#   cp env/alc.env.example env/alc.local.env
#
# Do NOT put universal hub / cluster settings here — set those everywhere via:
#   - HUB_URL, HUB_PASSWORD (or HUB_TOKEN) for ./start.sh
#   - HUB_PASSWORD (and optional CONSOLE_USERNAME, CONSOLE_IDP) in .env or the shell
#   - PLAYWRIGHT_TEST_MODE or TEST_MODE in the shell if you need a mode label
#   - OC_CLUSTER_URL / OC_CLUSTER_USER / OC_CLUSTER_PASS: derived in alc-env.sh from
#     HUB_URL and HUB_PASSWORD unless you override in the shell for special cases

# Object store (ALC tests that need S3 / UI links)
# OBJECTSTORE_ACCESS_KEY=
# OBJECTSTORE_SECRET_KEY=
# OBJECTSTORE_PRIVATE_URL=
# OBJECTSTORE_REGION=us-east-2

# Ansible Automation Platform
# ANSIBLE_TOKEN=
# ANSIBLE_URL=https://aap.example.com
