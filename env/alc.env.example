# ALC *local-only* integrations. Copy to alc.local.env (gitignored):
#   cp env/alc.env.example env/alc.local.env
#
# Universal hub / console settings stay in repo-root `.env` (HUB_URL, HUB_PASSWORD, CONSOLE_*).
# Ansible Automation Platform: repo-root `.env` (ANSIBLE_URL, ANSIBLE_TOWER_PASSWORD, …).

# --- Private Git auth (RHACM4K-1071 subscription wizard; RHACM4K-63608 Argo push AppSet wizard) ---
# Repository URL is in e2e-spec-data (like public sample repos), not here.
# GITHUB_USER and GITHUB_TOKEN must be base64-encoded.
#
# Example (encode with: echo -n 'myuser' | base64):
# GITHUB_USER=bXl1c2Vy
# GITHUB_TOKEN=Z2hwX3h4eHh4

# GITHUB_USER=
# GITHUB_TOKEN=

# --- Object store (ALC tests that need S3 / UI links) ---
# OBJECTSTORE_ACCESS_KEY=
# OBJECTSTORE_SECRET_KEY=
# OBJECTSTORE_PRIVATE_URL=
# OBJECTSTORE_REGION=us-east-2
