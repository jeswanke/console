# CLC *local-only* cloud credentials. Copy to clc.local.env (gitignored):
#   cp env/clc.env.example env/clc.local.env
#
# Universal hub / console settings stay in repo-root `.env` (HUB_PASSWORD, CONSOLE_*).
#
# VALUES: Each variable accepts either a FILE PATH or INLINE CONTENT.
#   - File path: starts with `/`, `./`, or `~` → read from disk
#   - Inline: anything else → used as-is
#
# MULTI-LINE VALUES (SSH keys, JSON):
#   Double-quote the value and use literal \n for newlines:
#   CLC_SSH_PUBLIC_KEY="ssh-rsa AAAA...== user@host"
#   CLC_SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\nb3BlbnN...\n-----END OPENSSH PRIVATE KEY-----"
#   CLC_PULL_SECRET='{"auths":{"cloud.openshift.com":{"auth":"...","email":"..."}}}'

# --- Shared secrets (required for all providers) ---
# Accepts file path OR inline JSON/key content.
# CLC_PULL_SECRET=/path/to/pull-secret.json
# CLC_SSH_PRIVATE_KEY=/path/to/id_rsa
# CLC_SSH_PUBLIC_KEY=/path/to/id_rsa.pub

# --- OCP release image ---
# CLC_OCP_IMAGE_VERSION=4.22
# CLC_OCP_IMAGE_ARCH=multi
# CLC_OCP_IMAGE_REGISTRY=quay.io/openshift-release-dev/ocp-release

# --- CI overrides (optional — override YAML spec data fields per-run) ---
# JSON object merged on top of resolved scenario params. Any field in the
# cluster create schema is accepted; Zod validates the result.
# CLC_OVERRIDES='{"architecture":"arm64","fips":true}'

# --- AWS ---
# CLC_AWS_ACCESS_KEY_ID=
# CLC_AWS_SECRET_ACCESS_KEY=
# CLC_AWS_BASE_DOMAIN=

# --- GCP ---
# CLC_GCP_PROJECT_ID=
# CLC_GCP_SERVICE_ACCOUNT_JSON=/path/to/osServiceAccount.json
# CLC_GCP_BASE_DOMAIN=

# --- Azure ---
# CLC_AZURE_BASE_DOMAIN_RG=
# CLC_AZURE_CLIENT_ID=
# CLC_AZURE_CLIENT_SECRET=
# CLC_AZURE_TENANT_ID=
# CLC_AZURE_SUBSCRIPTION_ID=
# CLC_AZURE_BASE_DOMAIN=
# CLC_AZURE_CLOUD_NAME=AzurePublicCloud

# --- Azure Government ---
# CLC_AZGOV_BASE_DOMAIN_RG=
# CLC_AZGOV_CLIENT_ID=
# CLC_AZGOV_CLIENT_SECRET=
# CLC_AZGOV_TENANT_ID=
# CLC_AZGOV_SUBSCRIPTION_ID=
# CLC_AZGOV_BASE_DOMAIN=
# CLC_AZGOV_CLOUD_NAME=AzureUSGovernmentCloud

# --- VMware ---
# CLC_VMWARE_VCENTER=
# CLC_VMWARE_USERNAME=
# CLC_VMWARE_PASSWORD=
# CLC_VMWARE_CACERTIFICATE=/path/to/cacert.pem
# CLC_VMWARE_CLUSTER=
# CLC_VMWARE_DATACENTER=
# CLC_VMWARE_DATASTORE=
# CLC_VMWARE_BASE_DOMAIN=

# --- OpenStack ---
# CLC_OPENSTACK_CLOUDS_YAML=/path/to/clouds.yaml
# CLC_OPENSTACK_CLOUD_NAME=openstack
# CLC_OPENSTACK_BASE_DOMAIN=
# CLC_OPENSTACK_CLUSTER_OS_IMAGE=

# --- KubeVirt (Hosted) ---
# CLC_KUBEVIRT_NAMESPACE=clusters
