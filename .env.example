# Universal environment — copy to `.env` (gitignored). Used by:
#   - ./start.sh (sources this file for oc login + exports to Playwright)
#   - Playwright / src/config/index.ts (dotenv)
#
# ALC-only integrations (private Git GITHUB_USER/TOKEN, object store OBJECTSTORE_*): env/alc.local.env (see env/alc.env.example).

# --- Cluster API (oc login) ---
HUB_URL=https://api.example.com:6443
HUB_PASSWORD=
# HUB_TOKEN=   # alternative to HUB_PASSWORD

# --- OpenShift web console (Playwright auth.setup) ---
# Password is always HUB_PASSWORD. Optional overrides for the login form:
CONSOLE_USERNAME=kubeadmin
CONSOLE_IDP=kube:admin

# --- Ansible Automation Platform (global prep on non-unit runs) ---
# Preferred explicit input:
# ANSIBLE_URL=https://aap.example.com
# ANSIBLE_TOWER_PASSWORD=
# Optional: if omitted, prep script will mint ANSIBLE_TOKEN from URL/password.
# ANSIBLE_TOKEN=
# Optional: if URL/password are omitted, prep script discovers route/password/token
# from OpenShift secrets in AAP_NAMESPACE (default `aap`).
# AAP_NAMESPACE=aap
# E2E_SKIP_ANSIBLE_PREP=1       # skip global ansible prep in globalSetup
# E2E_ANSIBLE_AWX_BOOTSTRAP=0   # skip AWX project/template bootstrap (secret still ensured)
# E2E_SKIP_OPERATOR_PREFLIGHT=1 # skip hub checks for AAP + OpenShift GitOps pods before prep

# --- Optional ---
# TEST_MODE=e2e
# PLAYWRIGHT_TEST_MODE=e2e
# BASE_URL=   # usually set automatically from `oc whoami --show-console` after login

# --- Managed cluster JSON (globalSetup runs scripts/cluster/generate-managed-cluster-data.py by default for UI runs) ---
# E2E_SKIP_MANAGED_CLUSTER_PREP=1   # skip generator when hub/python/oc unavailable (unit-only runs skip prep automatically)
# E2E_GITOPS_PREP=0                 # disable ALC GitOps globalSetup hook (./start.sh alc sets 1 by default)
# PYTHON_BIN=python3
# MANAGED_CLUSTER_CONTEXT_PATH=.auth/managedClusters.json
